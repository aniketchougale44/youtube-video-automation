# ============================================================================
# AutoTube AI — environment configuration
# Copy to .env and fill in. Never commit the real .env file.
#
# NOTE: put explanatory comments on their OWN line, never trailing after a value —
# some env-file parsers append trailing "# ..." text straight into the value itself.
# ============================================================================

# --- App ---
# APP_ENV: development | staging | production
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Human-in-the-loop ---
# REQUIRE_HUMAN_APPROVAL: false = auto-publish once trust is established
REQUIRE_HUMAN_APPROVAL=true
# QUALITY_SCORE_THRESHOLD: 0-10 scale, critic reject-below threshold
QUALITY_SCORE_THRESHOLD=8.5
MAX_CRITIC_RETRIES=3
# ORIGINALITY_SIMILARITY_THRESHOLD: 0-1 cosine similarity scale (NOT the 0-10 scale above) —
# Script QA rejects when max similarity to real external/other-channel transcripts exceeds this
# (genuine plagiarism protection; transcript ingestion isn't wired up yet, so this currently never
# has any external matches to compare against).
ORIGINALITY_SIMILARITY_THRESHOLD=0.82
# ORIGINALITY_OWN_CATALOG_SIMILARITY_THRESHOLD: same 0-1 scale, applied instead to matches against
# THIS channel's own back catalog of previously-passed scripts. Deliberately looser than the
# external threshold -- a narrow, format-consistent niche (nursery rhymes, ABC songs, etc.)
# legitimately sounds similar episode to episode; that's genre convention, not plagiarism.
ORIGINALITY_OWN_CATALOG_SIMILARITY_THRESHOLD=0.95

# --- Channel strategy ---
CHANNEL_GOALS="Grow a general knowledge/educational YouTube channel with evergreen, highly re-watchable long-form content."
TREND_REGION_CODE=US
# TREND_CATEGORY_IDS: comma-separated YouTube category IDs, e.g. 27,28 -- empty = no filter
TREND_CATEGORY_IDS=
MAX_TREND_CANDIDATES=5

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autotube
POSTGRES_USER=autotube
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://autotube:change-me@postgres:5432/autotube

# --- Redis (Celery broker/backend + cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Scheduling ---
# PIPELINE_CRON_SCHEDULE: 3x/week, 14:00 UTC
PIPELINE_CRON_SCHEDULE="0 14 * * mon,wed,fri"

# --- LLM providers ---
# Tried in this order, each skipped if its key is empty: anthropic -> openai -> groq -> gemini.
# GROQ_API_KEY and GOOGLE_API_KEY are free tier, no card required -- you can run the whole
# pipeline on just one of those two and leave ANTHROPIC_API_KEY/OPENAI_API_KEY blank.
ANTHROPIC_API_KEY=
LLM_PRIMARY_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
LLM_FALLBACK_MODEL=gpt-4o-mini
# GROQ_API_KEY: free, no card -- https://console.groq.com/keys
GROQ_API_KEY=
LLM_GROQ_MODEL=llama-3.3-70b-versatile
# GOOGLE_API_KEY: free, no card -- https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_GEMINI_MODEL=gemini-2.0-flash
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autotube-ai
LANGSMITH_TRACING=true

# --- YouTube Data API v3 / Analytics API (OAuth2) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
# YOUTUBE_API_KEY: server key for read-only public endpoints (search, mostPopular)
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_UNITS=10000
# Privacy status upload_node uses: unlisted (default) | private | public
YOUTUBE_UPLOAD_VISIBILITY=unlisted
# Every uploaded video is added to this playlist (created on first use, then reused by title)
YOUTUBE_NURSERY_PLAYLIST_TITLE="Nursery Rhymes & Learning for Toddlers"
# PubSubHubbub / WebSub push notifications (api/routes/webhooks.py -> POST/GET /api/webhooks/youtube).
# Subscribe once the API is reachable on a public https URL: python -m tools.websub subscribe
# (scheduler/beat.py also renews it daily). All three optional -- leave blank to skip the feature.
YOUTUBE_WEBSUB_CALLBACK_URL=
YOUTUBE_WEBSUB_VERIFY_TOKEN=
YOUTUBE_WEBSUB_SECRET=

# --- Research ---
TAVILY_API_KEY=
# Alternative: PERPLEXITY_API_KEY=

# --- Text-to-Speech ---
# TTS_PROVIDER: "openai" (paid, needs OPENAI_API_KEY) | anything else -> edge-tts (free, keyless,
# Microsoft Edge neural voices -- also the automatic fallback if the openai call fails/has no
# credits). ELEVENLABS_API_KEY / AZURE_SPEECH_KEY are reserved for a future provider, not yet
# implemented.
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-AndrewNeural
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Stock media --- (both free -- sign up for whichever key(s) you want; falls back to AI
# image-gen below when neither is set or a search comes back empty)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- AI video beats --- (see tools/hf_video.py / tools/nvidia_video.py / tools/veo_video.py /
# tools/colab_video.py; ENABLE_AI_VIDEO_BEATS is off by default -- see core/settings.py)
ENABLE_AI_VIDEO_BEATS=false
# AI_VIDEO_PROVIDER: "auto" = Colab (if COLAB_VIDEO_URL set) then fal -> HF -> NVIDIA -> Veo;
# "colab" = the offline Wan2.1-T2V-1.3B Colab endpoint ONLY, never a paid API; "none" = skip.
AI_VIDEO_PROVIDER=auto
# MAX_AI_VIDEO_BEATS_PER_RUN: 0 = no cap -- every beat the visual planner routes to AI_VIDEO gets a
# real generated clip, which is what makes the output an animated story instead of a mostly-mascot
# slideshow. Free-T4 Colab is ~6-12 min per beat, so a 12-beat script is a ~2 hour run; set a small
# positive number instead to cap it (that's the right shape for the metered hosted generators).
MAX_AI_VIDEO_BEATS_PER_RUN=0
# HUGGINGFACE_API_KEY: free to create, no card required -- huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# NVIDIA_API_KEY: nvapi- key from build.nvidia.com/settings/api-keys, used against the hosted
# nvidia/cosmos3-nano Preview API (the one Cosmos model that's actually hosted, not self-host-only)
NVIDIA_API_KEY=
NVIDIA_VIDEO_INVOKE_URL=
NVIDIA_VIDEO_RESOLUTION=720_16_9
NVIDIA_VIDEO_NUM_FRAMES=121
NVIDIA_VIDEO_FPS=24
# FAL_API_KEY: "id:secret" format key from fal.ai/dashboard/keys -- called directly (see
# tools/fal_video.py), tried first by asset_visual_node since it has no free-tier credit ceiling
FAL_API_KEY=
FAL_VIDEO_MODEL=fal-ai/wan-t2v
FAL_VIDEO_RESOLUTION=720p
FAL_VIDEO_ASPECT_RATIO=16:9

# --- Background sound for scripts/produce_reel_clip.py's short clips ---
# FREESOUND_API_KEY: free -- freesound.org/apiv2/apply -- searched by mood keyword; falls back to
# a locally synthesized ambient pad when unset
FREESOUND_API_KEY=

# --- Colab-hosted offline video generation -- see colab/wan_video_colab.ipynb + tools/colab_video.py.
# Model: Wan-AI/Wan2.1-T2V-1.3B (Apache-2.0), UMT5 text encoder offloaded to CPU so it fits a free
# T4; native 832x480 @ 16fps, num_frames must be 4k+1, ~10-20 min/clip. Run the notebook in Colab,
# paste the https://xxxx.gradio.live URL it prints below (changes every restart; blank = the
# AI_VIDEO beats fall back to the mascot). On Colab Pro switch the notebook to Wan2.2-TI2V-5B. ---
COLAB_VIDEO_URL=
COLAB_VIDEO_NUM_FRAMES=81
COLAB_VIDEO_HEIGHT=480
COLAB_VIDEO_WIDTH=832
COLAB_VIDEO_GUIDANCE_SCALE=5.0

# --- Image generation (thumbnails / illustrations) ---
# IMAGE_GEN_PROVIDER: "openai" (paid, needs OPENAI_API_KEY) | anything else -> Pollinations.ai
# (free, keyless, no signup -- also the automatic fallback if the openai call fails/has no
# credits). stability/replicate remain unimplemented (no free tier worth wiring alongside it).
IMAGE_GEN_PROVIDER=pollinations
OPENAI_IMAGE_MODEL=gpt-image-1
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# --- Mascot character (tools/character_assets.py) ---
# A small pose pack (idle/talk/blink/wave) generated ONCE and cached under MEDIA_DIR/characters/,
# then reused free by every render -- replaces the old single-AI-still Ken-Burns-pan for AI_IMAGE
# beats with an actually-animated character. If OPENAI_API_KEY is set, poses after the first are
# generated via OpenAI's image *edit* endpoint against the base pose for much better character
# consistency; otherwise every pose falls back to independent Pollinations calls (best-effort only).
MASCOT_CHARACTER_NAME="Mimi the Fox"
MASCOT_CHARACTER_PROMPT="Mimi the Fox: a cheerful, round-bodied orange fox cub with big sparkling brown eyes, a white belly and cheek patches, small rounded ears, and a red-and-white striped overall"

# --- Notifications ---
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Media --- (rendered voiceover/assets/render/thumbnails land under here, per-run subfolders)
MEDIA_DIR=./media

# --- Review dashboard ---
DASHBOARD_BASE_URL=http://localhost:8000
DASHBOARD_BASIC_AUTH_USER=admin
DASHBOARD_BASIC_AUTH_PASSWORD=change-me
